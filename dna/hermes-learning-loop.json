{
  "schema": "mekong.hermes_learning_loop.v1",
  "version": "2026.08.26",
  "mission": "Closed learning loop: remember outcomes, improve procedures, expose safe tools, and reuse skills across sessions.",
  "capabilities": [
    {
      "id": "persistent-memory",
      "description": "Execution memory survives across sessions.",
      "required_files": ["src/core/memory_client.py", "src/core/memory_store.py"]
    },
    {
      "id": "scoped-memory",
      "description": "Memory access is isolated by app/org/user/agent/session scope.",
      "required_files": ["src/core/memory_scope.py"]
    },
    {
      "id": "procedural-memory",
      "description": "Procedural memory supports skills, recipes, and reusable patterns.",
      "required_files": ["src/core/vector_memory_store.py", "src/cli/recipe_commands.py"]
    },
    {
      "id": "mcp-tool-gateway",
      "description": "MCP exposes memory, tasks, plans, skills, and system tools through a controlled gateway.",
      "required_files": ["src/core/mcp_server.py", "src/core/mcp_task_store.py", "src/core/mcp_plan_store.py"]
    },
    {
      "id": "skill-surface",
      "description": "Reusable command/skill surface exists for agent procedures.",
      "required_files": ["src/cli/cook_command.py", "src/core/plugin_runtime.py"]
    }
  ],
  "loop": [
    "execute",
    "record_memory",
    "reflect",
    "extract_procedure",
    "reuse_skill",
    "verify_with_harness_eval"
  ]
}
